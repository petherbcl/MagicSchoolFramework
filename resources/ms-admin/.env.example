# Role (from ms-core) that may use the staff commands. Default: admin
MS_ADMIN_ROLE=admin
# Turn the noclip effects on or off (true/false). Default: true
MS_ADMIN_NOCLIP_FX_ENABLED=true
# Smoke while in noclip: Niagara/Cascade asset path (list candidates in game with /fxlist smoke).
# Empty = pick the first catalog entry that looks like smoke.
MS_ADMIN_NOCLIP_FX=
# Optional Player.setSkinFx name applied while in noclip.
MS_ADMIN_NOCLIP_SKINFX=
