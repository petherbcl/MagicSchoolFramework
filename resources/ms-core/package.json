{
  "name": "ms-core",
  "version": "0.4.0",
  "private": true,
  "description": "MagicSchoolRP PostgreSQL accounts, numeric registration IDs and external allowlist",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "admin": "node tools/admin.js"
  },
  "mafiahub": {
    "serverScripts": [
      "server/main.js"
    ],
    "clientScripts": [
      "client/main.js"
    ],
    "files": [
      "client/ui/index.html",
      "client/ui/app.js",
      "client/ui/style.css"
    ],
    "exports": [
      "Core"
    ],
    "errorBehavior": "stop"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19"
  }
}
