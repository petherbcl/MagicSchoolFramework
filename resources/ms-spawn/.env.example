# ms-spawn configuration. Copy to .env (gitignored). Process environment variables override this file.
# ms-spawn has NO database settings: it does not use ms-sql.

# Locations offered after a character is selected: a JSON array of 0 to 12 entries, each
#   {"name", "x","y","z","yaw", "role"?, "icon"?, "camera": {"x","y","z","lookAt"?: {"x","y","z"}}}
# - name: 1-40 chars. The id of each location is derived from it (lowercase slug: "Sala Comum Slytherin" -> sala-comum-slytherin).
# - x,y,z (centimetres) and yaw (degrees): the SPAWN POINT, where the character appears after the player confirms. Coordinates come from /pos in game;
#   whether each point is a safe spawn is still to be verified in game.
# - camera (mandatory since 0.5.0, CHG-05): where the camera sits while the player looks at the place, in centimetres. The invisible player is
#   teleported to this point on every select so the world streams around the view. "lookAt" (optional, {x,y,z}) is the point the camera
#   looks at; missing = the spawn point. A camera equal to its lookAt (or, without lookAt, to the spawn point) is invalid.
#   CHG-06 (0.5.1): instead of lookAt the camera may aim with "yaw" (degrees, -360..360; 0 looks along +X) and an optional "pitch"
#   (degrees, -89..89, default 0; positive looks up), e.g. "camera":{"x":1,"y":2,"z":3,"yaw":90,"pitch":-15}. Three modes, never mixed:
#   lookAt | yaw (+pitch) | neither (looks at the spawn point, as the 6 defaults below). lookAt with yaw/pitch, pitch without yaw, or a
#   null/non-numeric/out-of-range yaw or pitch refuses to start (LOCATION_CAMERA_INVALID). The swoop start (departure) goes back along
#   the opposite of the yaw direction (pitch ignored) and up; the camera may then sit at the spawn point.
#   MS_SPAWN_CAMERA_DISTANCE/HEIGHT below no longer shape these locations: they only affect the "Última localização" entry.
# - icon (optional): a file name [a-z0-9_-]+.(png|webp|jpg|jpeg|svg), at most 64 chars, of an image in resources/ms-spawn/ui-src/public/icons/
#   (then run: npm.cmd run build:ui --prefix resources/ms-spawn). Missing or "" = the pin icon. The four common rooms below use the house crests.
# - role (optional, CHG-04): [a-z0-9_-], 1-32 chars; missing or "" = open to everyone. A location with a role is offered only to characters that
#   have that role (the house role counts, e.g. "gryffindor"). A malformed role refuses to start; an unknown role is accepted and never matches.
#   In the default 6 below the four common rooms carry their house role; the courtyard and Hogsmeade are open to everyone.
# Invalid JSON or an invalid entry (an OLD-format entry without camera included) makes ms-spawn refuse to start (ms-character then falls back
# to its default spawn). To convert an old value: node resources/ms-spawn/tools/migrate-locations.js (prints; never writes your .env).
# The cameras below were generated by that tool from the previous defaults (1200 cm behind, 600 cm above the spawn point, looking at it).
MS_SPAWN_LOCATIONS='[{"name": "Sala Comum Slytherin","role": "slytherin","x": 359573,"y": -451727.25,"z": -85308.25,"yaw": -146.48,"icon": "slytherin.png","camera": {"x": 359744.75, "y": -457296.41, "z": -86174.76, "yaw": -97.9}},{"name": "Sala Comum Hufflepuff","role": "hufflepuff","x": 362522.25,"y": -445054.25,"z": -83609.5,"yaw": -107.16,"icon": "hufflepuff.png","camera": {"x": 363401.53, "y": -449680.09, "z": -83463.83, "yaw": -11.53}},{"name": "Sala Comum Gryffindor","role": "gryffindor","x": 353218.75,"y": -450775,"z": -79306.5,"yaw": 10.53,"icon": "gryffindor.png","camera": {"x": 355538, "y": -449773.03, "z": -80418.61, "yaw": -46.82}},{"name": "Sala Comum Ravenclaw","role": "ravenclaw","x": 357398.75,"y": -455215.5,"z": -77308,"yaw": -80.18,"icon": "ravenclaw.png","camera": {"x": 357302.25, "y": -456632.97, "z": -77755.96, "yaw": -104.37}},{"name": "Pátio de Hogwarts","x": 368521.5,"y": -458878.75,"z": -82609.5,"yaw": -16.3,"camera": {"x": 367462.44,"y": -462217.75,"z": -82449.89,"yaw": 91.5}},{"name": "Hogsmeade","x": 395037.5,"y": -519061,"z": -82090.25,"yaw": 112.24,"camera": {"x": 396837.78,"y": -518368.94,"z": -81915.69,"yaw": -154.2}}]'

# Camera flight (defaults are provisional until tuned in game, see docs/ms-spawn-runtime-findings.md).
# Flight duration in milliseconds (300-10000) and easing: linear | smoothStep | easeIn | easeOut | easeInOut.
MS_SPAWN_CAMERA_DURATION_MS=1500
MS_SPAWN_CAMERA_EASING=easeInOut
# Where the camera ends, relative to the spawn point: centimetres behind it (100-20000) and above it (0-20000).
# The camera looks at the spawn point; its pitch is derived from these two values.
MS_SPAWN_CAMERA_DISTANCE=1200
MS_SPAWN_CAMERA_HEIGHT=600
# Where the swoop starts (CHG-02), as an EXTRA on top of the two values above: centimetres higher (0-20000) and farther
# behind (0-20000). The camera waits there under the loading cover and flies to the target pose once the cover lifts.
MS_SPAWN_CAMERA_DEPARTURE_HEIGHT=0
MS_SPAWN_CAMERA_DEPARTURE_DISTANCE=0
# 0/0 = no zoom: the camera is parked at the final pose under the cover. Raise both (e.g. 1500 / 3000) for an aerial swoop,
# but a far start often sits outside the models.

# Ceiling of the loading cover (milliseconds, 1000-60000). The client keeps the screen covered after a select until the
# teleport is done and the ground trace hits, but never longer than this (it restarts on every select); the ceiling with the
# teleport done is not a failure. The server accepts a confirm this long after a selection even without an arrival report.
# Default 15000 since 0.3.0; tune it in game (docs/ms-spawn-runtime-findings.md).
MS_SPAWN_AREA_TIMEOUT_MS=15000

# Liveness of the client page: milliseconds (5000-600000). When the page of a selection never reports it opened
# (client script error, CEF page failed, client gone), the selection is cancelled after this long and ms-character lets the
# player in at its default spawn. The clock stops at the first acknowledgement: an idle player is never timed out.
MS_SPAWN_OPEN_ACK_TIMEOUT_MS=30000

# CHG-03: whether the preview teleport of each select asks the game for snapToGround (true/false). Default false: the invisible
# held player only streams the world around the camera, and with snapToGround the game holds it until the floor loads (up to 20 s).
# Only the preview move is affected; ms-character's own teleport at confirm is unchanged.
MS_SPAWN_PREVIEW_SNAP_TO_GROUND=false

# CHG-03: timing log for calibrating the loading (true/false). Default true for now; set false to silence it once calibrated.
# Server: one line per select when the teleport result arrives. Client: one console line per select when the cover lifts.
# No coordinates and no account data in either line.
MS_SPAWN_TIMING_LOG=true
