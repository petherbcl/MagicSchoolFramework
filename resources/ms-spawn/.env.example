# ms-spawn configuration. Copy to .env (gitignored). Process environment variables override this file.
# ms-spawn has NO database settings: it does not use ms-sql.

# Locations offered after a character is selected: a JSON array of 0 to 12 entries
# {"name": 1-40 chars, "x","y","z": centimetres, "yaw": degrees}. The id of each location is derived from its name
# (lowercase slug: "Sala Comum Slytherin" -> sala-comum-slytherin). Invalid JSON or an invalid entry makes ms-spawn
# refuse to start (ms-character then falls back to its default spawn).
# Coordinates come from /pos in game; whether each point is a safe spawn is still to be verified in game.
MS_SPAWN_LOCATIONS='[{"name":"Sala Comum Slytherin","x":359573,"y":-451727.25,"z":-85308.25,"yaw":-146.48},{"name":"Sala Comum Hufflepuff","x":362522.25,"y":-445054.25,"z":-83609.5,"yaw":-107.16},{"name":"Sala Comum Gryffindor","x":353218.75,"y":-450775,"z":-79306.5,"yaw":10.53},{"name":"Sala Comum Ravenclaw","x":357398.75,"y":-455215.5,"z":-77308,"yaw":-80.18},{"name":"Pátio de Hogwarts","x":368521.5,"y":-458878.75,"z":-82609.5,"yaw":-16.3},{"name":"Hogsmeade","x":395037.5,"y":-519061,"z":-82090.25,"yaw":112.24}]'

# Camera flight (defaults are provisional until tuned in game, see docs/ms-spawn-runtime-findings.md).
# Flight duration in milliseconds (300-10000) and easing: linear | smoothStep | easeIn | easeOut | easeInOut.
MS_SPAWN_CAMERA_DURATION_MS=1500
MS_SPAWN_CAMERA_EASING=easeInOut
# Where the camera ends, relative to the spawn point: centimetres behind it (100-20000) and above it (0-20000).
# The camera looks at the spawn point; its pitch is derived from these two values.
MS_SPAWN_CAMERA_DISTANCE=1200
MS_SPAWN_CAMERA_HEIGHT=600
# Where the swoop starts (CHG-02), as an EXTRA on top of the two values above: centimetres higher (0-20000) and farther
# behind (0-20000). The camera waits there under the loading cover and flies to the target pose once the cover lifts.
MS_SPAWN_CAMERA_DEPARTURE_HEIGHT=0
MS_SPAWN_CAMERA_DEPARTURE_DISTANCE=0
# 0/0 = no zoom: the camera is parked at the final pose under the cover. Raise both (e.g. 1500 / 3000) for an aerial swoop,
# but a far start often sits outside the models.

# Ceiling of the loading cover (milliseconds, 1000-60000). The client keeps the screen covered after a select until the
# teleport is done and the ground trace hits, but never longer than this (it restarts on every select); the ceiling with the
# teleport done is not a failure. The server accepts a confirm this long after a selection even without an arrival report.
# Default 15000 since 0.3.0; tune it in game (docs/ms-spawn-runtime-findings.md).
MS_SPAWN_AREA_TIMEOUT_MS=15000

# Liveness of the client page: milliseconds (5000-600000). When the page of a selection never reports it opened
# (client script error, CEF page failed, client gone), the selection is cancelled after this long and ms-character lets the
# player in at its default spawn. The clock stops at the first acknowledgement: an idle player is never timed out.
MS_SPAWN_OPEN_ACK_TIMEOUT_MS=30000
