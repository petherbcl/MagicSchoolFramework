# Optional: copy to resources/ms-character/.env. Values missing here are read from
# resources/ms-core/.env (MS_DATABASE_URL is normally shared). Process env takes precedence.
# MS_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/MagicSchoolRP
MS_CHARACTER_POOL_SIZE=3
MS_MAX_CHARACTERS=1
MS_SAVE_INTERVAL_SECONDS=30
MS_MAX_CREATIONS_PER_DAY=5
MS_DELETED_RETENTION_DAYS=30
