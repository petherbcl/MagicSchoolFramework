# Optional: copy to resources/ms-character/.env. Process env takes precedence.
# There is no database setting here: the connection belongs to ms-sql (resources/ms-sql/.env, MS_SQL_URL).
MS_MAX_CHARACTERS=1
MS_SAVE_INTERVAL_SECONDS=30
MS_MAX_CREATIONS_PER_DAY=5
MS_DELETED_RETENTION_DAYS=30
# Coordinates as x,y,z,yaw (use /pos in game). Lobby: where the player waits while choosing a character.
# Spawn: where a new character first appears (and the fallback if ms-spawn is not used).
MS_LOBBY_POSITION=349817,-466133,-84908,123
MS_SPAWN_POSITION=366784,-461527,-82610,-130
