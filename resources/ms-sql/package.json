{
  "name": "ms-sql",
  "version": "0.2.0",
  "private": true,
  "description": "MagicSchoolRP database access layer (PostgreSQL, MySQL and MariaDB behind one async API)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "mafiahub": {
    "serverScripts": [
      "server/main.js"
    ],
    "exports": [
      "Sql"
    ],
    "errorBehavior": "stop"
  },
  "dependencies": {
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19"
  }
}
