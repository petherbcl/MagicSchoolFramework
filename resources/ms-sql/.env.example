# Copy to .env (gitignored). The dialect is taken from the URL protocol.
# PostgreSQL: postgresql://user:password@127.0.0.1:5432/database
# MySQL:      mysql://user:password@127.0.0.1:3306/database
# MariaDB:    mariadb://user:password@127.0.0.1:3306/database
# Without a URL the resource starts, but isReady() stays false and every query is rejected with NOT_READY.
MS_SQL_URL=

# Schema (PostgreSQL) or database (MySQL/MariaDB) that holds ALL tables. Required with MS_SQL_URL.
# Letters, digits and underscore, not starting with a digit, max 63 chars. ms-sql creates it at startup if it does
# not exist (needs CREATE on the database/schema); ms-core and ms-character never create or name it.
# MySQL/MariaDB: this IS the database, and the database in MS_SQL_URL is ignored.
MS_SQL_SCHEMA=magic_school_rp

# Pool size, 1..20 (default 5)
MS_SQL_POOL_SIZE=5

# Per-query timeout in milliseconds (default 10000)
MS_SQL_QUERY_TIMEOUT_MS=10000

# Log queries slower than this many milliseconds, SQL only, no values (default 1000, 0 disables)
MS_SQL_SLOW_QUERY_MS=1000

# true verifies the server TLS certificate (default false). Required for any non-local host: with false and a
# remote host the resource logs a warning. Query string parameters in MS_SQL_URL (sslmode, ...) are ignored.
MS_SQL_SSL=false

# Path to a PEM file with the CA certificate, for a database that uses a private CA. Needs MS_SQL_SSL=true.
MS_SQL_SSL_CA=

# Size limits (defaults shown): SQL text in bytes, parameters per query, entries per rawExecute/transaction([...])
MS_SQL_MAX_SQL_BYTES=1048576
MS_SQL_MAX_PARAMS=65535
MS_SQL_MAX_BATCH=10000

# Max time a transaction(fn) or withLock(fn) may hold its connection, in ms (default 60000).
# On expiry the connection is destroyed and the call rejects with TIMEOUT.
MS_SQL_HOLD_TIMEOUT_MS=60000
